# Project Needle - build-time configuration (Vite). Copy to `.env.production.local` (or `.env.local`) and fill in.
# These values are compiled INTO the client bundle: they are identifiers, not secrets. Env only keeps our concrete
# keys out of Git and lets dev / production builds use different ByteBrew games. See docs/ANALYTICS_SETUP.md.

# ByteBrew Web app keys (ByteBrew dashboard > Game Settings > Web). Leave empty: remote analytics off (no-op).
VITE_BYTEBREW_WEB_APP_ID=
VITE_BYTEBREW_WEB_SDK_KEY=

# Build version sent as `game_version` on every event. Set a new value for every CrazyGames upload.
VITE_APP_VERSION=0.2.0-basic-launch

# 'false' turns remote analytics off for this build even with keys set.
VITE_ANALYTICS_ENABLED=true

# https URL of the privacy policy linked from the in-game analytics notice (required before enabling ByteBrew in
# production: CrazyGames "User Consent" requirement). Written and hosted by you; the game does not ship one.
VITE_PRIVACY_POLICY_URL=
