# Project Needle - build-time configuration (Vite). Copy to `.env.production.local` (npm run build) and/or
# `.env.development.local` (npm run dev) and fill in. These values are compiled INTO the client bundle: they are
# identifiers, not secrets. Env only keeps our concrete keys out of Git. See docs/ANALYTICS_SETUP.md.
#
# Remote analytics is OPT-IN: even with everything below set, ByteBrew is loaded only after the player clicks
# "Allow analytics" (or turns it on in Settings). Without keys, or without a valid https privacy policy URL, it is
# never available (the game works normally, no consent card). `?analytics=0` in the URL always disables it.

# ByteBrew Web app keys (ByteBrew dashboard > Game Settings > Web). Use a DEV game for .env.development.local.
VITE_BYTEBREW_WEB_APP_ID=
VITE_BYTEBREW_WEB_SDK_KEY=

# https URL of YOUR privacy policy (content checklist: docs/ANALYTICS_PRIVACY_NOTES.md section 6).
# Required for remote analytics in any build except the Vite dev server on localhost.
VITE_PRIVACY_POLICY_URL=

# Build version sent as `game_version` on every event. Set a new value for every CrazyGames upload.
VITE_APP_VERSION=0.2.1-basic-launch

# 'false' turns remote analytics off for this build even with keys set (no card, no SDK).
VITE_ANALYTICS_ENABLED=true
