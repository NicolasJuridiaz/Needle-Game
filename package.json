{
  "name": "project-needle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project Needle - first-person incremental factory game for the web (CrazyGames).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
