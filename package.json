    "balance:many": "vite-node tools/balance/runMany.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-node": "*",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
